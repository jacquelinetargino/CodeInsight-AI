# ============================================================
# CodeInsight AI — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA versione o arquivo ".env" (já está no .gitignore).
# ============================================================

# ---------- App ----------
APP_ENV=development
APP_NAME=CodeInsight AI
API_V1_PREFIX=/api/v1
# Origens permitidas no CORS. Aceita várias, separadas por vírgula
# (ex.: https://app.exemplo.com,http://localhost:5173).
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---------- Banco de dados ----------
POSTGRES_USER=codeinsight
POSTGRES_PASSWORD=changeme
POSTGRES_DB=codeinsight
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://codeinsight:changeme@postgres:5432/codeinsight

# ---------- Segurança ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Criptografa o PAT do GitHub em repouso.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key

# ---------- GitHub ----------
# Não há OAuth App: qualquer repositório público pode ser analisado sem token.
# GITHUB_TOKEN é opcional — um Personal Access Token do PRÓPRIO SERVIDOR (não do
# usuário final) para elevar o rate limit de 60 para 5000 req/h em repos públicos.
# Crie em https://github.com/settings/tokens (sem escopos, "public_repo" basta).
GITHUB_TOKEN=

# ---------- Provedor de IA (OPCIONAL — ver docs/ai-providers.md) ----------
# A análise de repositórios NÃO precisa de nada nesta seção: ela roda no
# CodeInsight Engine, em Python, sem serviço externo nem créditos de API.
#
# Preencha apenas se quiser habilitar os recursos complementares: explicar
# achados, resumir relatórios, sugerir correções e gerar README. Deixando em
# branco, a aplicação sobe normalmente e esses recursos respondem 503.
#
# AI_PROVIDER: claude | openai | gemini | groq | local
# AI_MODEL em branco = modelo padrão do provider (obrigatório para local).
#
# Exemplo com Groq (plano gratuito, API compatível com a da OpenAI):
#   AI_PROVIDER=groq
#   AI_API_KEY=your-groq-api-key
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#   AI_MAX_CONTEXT_CHARS=16000
AI_PROVIDER=claude
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# Obrigatório apenas para AI_PROVIDER=local. Opcional para os demais, caso
# queira apontar para um endpoint compatível custom (para groq o padrão
# já é https://api.groq.com/openai/v1).
# - Rodando com Docker Compose (backend dentro de um container): use
#   http://host.docker.internal:11434/v1 para alcançar o Ollama do host.
# - Rodando o backend fora do Docker (direto na máquina): use
#   http://localhost:11434/v1.
AI_BASE_URL=
# Teto, em caracteres, do contexto enviado em cada prompt (~4 caracteres
# por token). Padrão 100000. Reduza em planos com limite de tokens por
# minuto — na Groq gratuita (12k TPM no llama-3.3-70b) use 16000.
AI_MAX_CONTEXT_CHARS=100000

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1

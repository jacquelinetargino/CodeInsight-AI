# ============================================================
# CodeInsight AI — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA versione o arquivo ".env" (já está no .gitignore).
# ============================================================

# ---------- App ----------
APP_ENV=development
APP_NAME=CodeInsight AI
API_V1_PREFIX=/api/v1
# Origens permitidas no CORS. Aceita várias, separadas por vírgula
# (ex.: https://app.exemplo.com,http://localhost:5173).
FRONTEND_URL=http://localhost:5173
# URL pública do backend: forma as callbacks do login social
# ({BACKEND_URL}/api/v1/auth/oauth/{google|github}/callback). Sem barra no final.
BACKEND_URL=http://localhost:8000
# Para onde vão o link do e-mail de redefinição e a volta do login social.
# Vazio = primeira origem de FRONTEND_URL. Em produção, defina explicitamente.
PUBLIC_FRONTEND_URL=

# ---------- Banco de dados ----------
POSTGRES_USER=codeinsight
POSTGRES_PASSWORD=changeme
POSTGRES_DB=codeinsight
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://codeinsight:changeme@postgres:5432/codeinsight

# ---------- Segurança ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Criptografa o PAT do GitHub em repouso.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key

# IP do cliente para o rate limit. 0 = usa o IP da conexão (dev, Docker, testes).
# Atrás de proxy (Render), é o número de proxies que acrescentam ao
# X-Forwarded-For. NÃO ative sem validar a cadeia real: errar para mais deixa o
# limite burlável. Passo a passo em docs/proxy-ip.md.
TRUSTED_PROXY_HOPS=0
# Liga GET /health/proxy (IPs mascarados) só durante essa validação.
PROXY_DIAGNOSTICS_ENABLED=false

# ---------- GitHub ----------
# Qualquer repositório público pode ser analisado sem token.
# GITHUB_TOKEN é opcional — um Personal Access Token do PRÓPRIO SERVIDOR (não do
# usuário final) para elevar o rate limit de 60 para 5000 req/h em repos públicos.
# Crie em https://github.com/settings/tokens (sem escopos, "public_repo" basta).
GITHUB_TOKEN=

# ---------- Login social (OPCIONAL — ver docs/oauth.md) ----------
# Cada provedor só aparece com id E secret definidos. Secrets SÓ no backend.
# O OAuth App do GitHub é só para o LOGIN (escopos read:user user:email): não
# substitui o GITHUB_TOKEN acima nem o PAT que cada usuário cola nas configurações.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------- E-mail (OPCIONAL — só para "esqueci a senha") ----------
# Envio pela API HTTP do Brevo (o plano gratuito do Render bloqueia SMTP).
# Sem isto, "esqueci a senha" responde 503 e o resto funciona igual.
# EMAIL_FROM precisa ser um remetente verificado no Brevo. O link enviado usa
# PUBLIC_FRONTEND_URL (ou a PRIMEIRA origem de FRONTEND_URL).
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=CodeInsight AI
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---------- Provedor de IA (OPCIONAL — ver docs/ai-providers.md) ----------
# A análise de repositórios NÃO precisa de nada nesta seção: ela roda no
# CodeInsight Engine, em Python, sem serviço externo nem créditos de API.
#
# Preencha apenas se quiser habilitar os recursos complementares: explicar
# achados, resumir relatórios, sugerir correções e gerar README. Deixando em
# branco, a aplicação sobe normalmente e esses recursos respondem 503.
#
# AI_PROVIDER: claude | openai | gemini | groq | local
# AI_MODEL em branco = modelo padrão do provider (obrigatório para local).
#
# Exemplo com Groq (plano gratuito, API compatível com a da OpenAI):
#   AI_PROVIDER=groq
#   AI_API_KEY=your-groq-api-key
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b
#   AI_MAX_CONTEXT_CHARS=6000
AI_PROVIDER=claude
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# Obrigatório apenas para AI_PROVIDER=local. Opcional para os demais, caso
# queira apontar para um endpoint compatível custom (para groq o padrão
# já é https://api.groq.com/openai/v1).
# - Rodando com Docker Compose (backend dentro de um container): use
#   http://host.docker.internal:11434/v1 para alcançar o Ollama do host.
# - Rodando o backend fora do Docker (direto na máquina): use
#   http://localhost:11434/v1.
AI_BASE_URL=
# Teto, em caracteres, do contexto enviado em cada prompt (~4 caracteres
# por token). Padrão 100000. Reduza em planos com limite de tokens por
# minuto — na Groq gratuita (8k TPM no gpt-oss-120b) use 6000.
AI_MAX_CONTEXT_CHARS=100000

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1

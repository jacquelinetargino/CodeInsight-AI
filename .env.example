# ============================================================
# CodeInsight AI — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA versione o arquivo ".env" (já está no .gitignore).
# ============================================================

# ---------- App ----------
APP_ENV=development
APP_NAME=CodeInsight AI
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---------- Banco de dados ----------
POSTGRES_USER=codeinsight
POSTGRES_PASSWORD=changeme
POSTGRES_DB=codeinsight
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://codeinsight:changeme@postgres:5432/codeinsight

# ---------- Segurança ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Criptografa o PAT do GitHub em repouso.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-fernet-key

# ---------- GitHub ----------
# Não há OAuth App: qualquer repositório público pode ser analisado sem token.
# GITHUB_TOKEN é opcional — um Personal Access Token do PRÓPRIO SERVIDOR (não do
# usuário final) para elevar o rate limit de 60 para 5000 req/h em repos públicos.
# Crie em https://github.com/settings/tokens (sem escopos, "public_repo" basta).
GITHUB_TOKEN=

# ---------- Provedor de IA (abstrato — ver docs/ai-providers.md) ----------
# AI_PROVIDER: claude | openai | gemini | local
AI_PROVIDER=claude
AI_API_KEY=replace-with-your-ai-provider-api-key
AI_MODEL=claude-sonnet-5
# Obrigatório apenas para AI_PROVIDER=local. Opcional para os demais, caso
# queira apontar para um endpoint compatível custom.
# - Rodando com Docker Compose (backend dentro de um container): use
#   http://host.docker.internal:11434/v1 para alcançar o Ollama do host.
# - Rodando o backend fora do Docker (direto na máquina): use
#   http://localhost:11434/v1.
AI_BASE_URL=

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
